find_package(OpenCV REQUIRED COMPONENTS core imgproc calib3d imgcodecs videoio)
add_library(dt46_media project/modules/media/calibration.cpp project/modules/media/recorder.cpp)
target_include_directories(dt46_media PUBLIC project ${OpenCV_INCLUDE_DIRS})
target_link_libraries(dt46_media PUBLIC ${OpenCV_LIBS})
add_executable(dt46_calibrate tools/calibrate_camera.cpp)
target_link_libraries(dt46_calibrate PRIVATE dt46_media nlohmann_json::nlohmann_json)
add_executable(dt46_sentry_variant tools/make_sentry_variant.cpp)
add_executable(dt46_replay tools/replay_sequence.cpp)
target_link_libraries(dt46_replay PRIVATE dt46_media dt46_debug)
target_compile_definitions(dt46_replay PRIVATE DT46_SOURCE_ROOT="${CMAKE_CURRENT_SOURCE_DIR}")
if(BUILD_TESTING)
    add_executable(dt46_media_check tests/media_check.cpp)
    target_link_libraries(dt46_media_check PRIVATE dt46_media)
    add_test(NAME native_media COMMAND dt46_media_check "${CMAKE_CURRENT_BINARY_DIR}/test-output/media")
endif()
