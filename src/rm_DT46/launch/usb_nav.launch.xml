<?xml version="1.0"?>
<launch>
  <arg name="camera_params_file" default="$(find-pkg-share usb_camera)/config/camera_params.yaml" />
  <arg name="camera_info_url" default="package://usb_camera/config/camera_info.yaml" />
  <arg name="use_sensor_data_qos" default="false" />
  <arg name="detector_params_file" default="$(find-pkg-share rm_detector)/config/detector_params.yaml" />
  <arg name="tracker_params_file" default="$(find-pkg-share rm_tracker)/config/tracker_params.yaml" />
  <arg name="dm_imu_params_file" default="$(find-pkg-share dm_imu)/config/dm_imu_params.yaml" />
  <node pkg="dm_imu" exec="dm_imu_node" name="dm_imu" output="screen">
    <param from="$(var dm_imu_params_file)" />
  </node>
  <node pkg="rm_detector" exec="rm_detector_node" name="rm_detector" output="screen">
    <param from="$(var detector_params_file)" />
  </node>
  <node pkg="rm_tracker" exec="rm_tracker_node" name="rm_tracker" output="screen">
    <param from="$(var tracker_params_file)" />
  </node>
  <node pkg="usb_camera" exec="usb_camera_node" name="usb_camera" output="screen">
    <param from="$(var camera_params_file)" />
    <param name="camera_info_url" value="$(var camera_info_url)" />
    <param name="use_sensor_data_qos" value="$(var use_sensor_data_qos)" />
  </node>
  <node pkg="rqt_gui" exec="rqt_gui" name="rqt_gui" output="screen" args="--perspective-file '$(env HOME)/DT46_V/Kielas_Vision.perspective'" />
</launch>
