<?xml version="1.0"?>
<launch>
  <arg name="params_file" default="$(find-pkg-share hik_camera)/config/camera_params.yaml" />
  <arg name="camera_info_url" default="package://hik_camera/config/camera_info.yaml" />
  <arg name="use_sensor_data_qos" default="false" />
  <node pkg="hik_camera" exec="hik_camera_node" output="screen">
    <param from="$(var params_file)" />
    <param name="camera_info_url" value="$(var camera_info_url)" />
    <param name="use_sensor_data_qos" value="$(var use_sensor_data_qos)" />
  </node>
</launch>
